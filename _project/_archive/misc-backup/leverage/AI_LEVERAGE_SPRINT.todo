  - Verify: Code examples are syntactically correct

#### VERIFICATION COMMANDS

```powershell
# V1.1 - Check file sizes (should be substantial)
(Get-Item _contexts/subsystems/vfs.md).Length
(Get-Item .windsurf/agents/vfs-specialist.md).Length

# V1.2 - Verify required sections exist
$vfsContent = Get-Content _contexts/subsystems/vfs.md -Raw
$requiredSections = @('Core Mechanism', 'Data Structures', 'Query Patterns', 'Known Failure Modes', 'Code Examples', 'Related Files')
$requiredSections | ForEach-Object {
    if ($vfsContent -match "## $_") { Write-Host "✓ $_" } else { Write-Host "✗ $_ MISSING" }
}

# V1.3 - Verify agent sections
$agentContent = Get-Content .windsurf/agents/vfs-specialist.md -Raw
$agentSections = @('Domain Scope', 'Key Knowledge', 'Tools Available', 'Common Patterns', 'Known Failure Modes', 'Related Agents')
$agentSections | ForEach-Object {
    if ($agentContent -match "## $_") { Write-Host "✓ $_" } else { Write-Host "✗ $_ MISSING" }
}
```

