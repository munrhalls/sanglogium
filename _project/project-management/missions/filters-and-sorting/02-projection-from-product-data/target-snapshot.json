            { "value": "Basshead", "label": "Basshead (Heavy Bass)" },
            { "value": "Mid-Forward", "label": "Mid-Forward (Prominent Vocals)" }
          ],
          "attribute": "soundSignature", "storage": "enum", "vocab": ["Neutral", "Warm", "Bright/Analytical", "Dark", "V-Shaped", "Basshead", "Mid-Forward", "Harman-target-like"]
        },
        {
          "id": "impedance", "group": "sound", "label": "Impedance", "control": "range",
          "min": 3, "max": 520, "unit": "Ω",
          "attribute": "impedanceOhms", "storage": "range", "vocab": ["min", "max"]
        },
        {
          "id": "sensitivity", "group": "sound", "label": "Sensitivity", "control": "range",
          "min": 89, "max": 128, "unit": "dB/mW",
          "attribute": "sensitivityDbMw", "storage": "range", "vocab": ["min", "max"]
        },
        {
          "id": "bassExtension", "group": "sound", "label": "Bass Extension", "control": "range",
          "min": 2, "max": 25, "unit": "Hz",
          "attribute": "freqResponseHz.min", "storage": "range", "vocab": ["min", "max"]
        },
        {
          "id": "microphone", "group": "material", "label": "Microphone", "control": "boolean",
          "attribute": "microphone", "storage": "boolean", "vocab": ["true", "false"]
        },
        {
          "id": "cableTermination", "group": "material", "label": "Cable Type", "control": "checkbox",
          "options": [
            { "value": "3.5mm", "label": "3.5mm SE" },
            { "value": "2.5mm-balanced", "label": "2.5mm Balanced" },
            { "value": "4.4mm-balanced", "label": "4.4mm Balanced" },
            { "value": "4-pin-xlr", "label": "4-Pin XLR" },
            { "value": "6.35mm", "label": "6.35mm (1/4 inch)" },
            { "value": "usb-c", "label": "USB-C" },
            { "value": "mmcx", "label": "MMCX (Snap-In)" }
