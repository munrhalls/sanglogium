          "attribute": "cableTermination", "storage": "multi", "vocab": ["3.5mm", "6.35mm", "4.4mm-balanced", "4-pin-xlr", "2.5mm-balanced", "usb-c", "mmcx", "2-pin", "fixed-cable"]
        },
        {
          "id": "foldable", "group": "material", "label": "Foldable", "control": "boolean",
          "attribute": "foldable", "storage": "boolean", "vocab": ["true", "false"]
        },
        {
          "id": "cableLength", "group": "material", "label": "Cable Length", "control": "range",
          "min": 0.2, "max": 4.0, "unit": "m",
          "attribute": "cableLengthM", "storage": "range", "vocab": ["min", "max"]
        },
        {
          "id": "ipx", "group": "material", "label": "Water Resistance (IPX)", "control": "checkbox",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "IPX4", "label": "IPX4 (Splash-Proof)" },
            { "value": "IPX5", "label": "IPX5 (Jets / Heavy Rain)" }
          ],
          "attribute": "ipxRating", "storage": "enum", "vocab": ["none", "IPX2", "IPX4", "IPX5", "IPX7", "IPX8"]
        },
        {
          "id": "requiresAmplifier", "group": "material", "label": "Requires Amplifier", "control": "boolean",
          "attribute": "requiresAmplifier", "storage": "boolean", "vocab": ["true", "false"]
        },
        {
          "id": "portable", "group": "material", "label": "Portable", "control": "boolean",
          "attribute": "portable", "storage": "boolean", "vocab": ["true", "false"]
        },
        {
          "id": "codec", "group": "wireless", "label": "Bluetooth Codec", "control": "checkbox",
          "options": [
            { "value": "SBC", "label": "SBC (Basic)" },
            { "value": "AAC", "label": "AAC (Apple-Optimized)" },
            { "value": "aptX", "label": "aptX" },
            { "value": "aptX HD", "label": "aptX HD (Hi-Res)" },
            { "value": "aptX Adaptive", "label": "aptX Adaptive (Auto-Adjusting)" },
            { "value": "aptX LL", "label": "aptX LL (Low-Latency)" },
            { "value": "LDAC", "label": "LDAC (Hi-Res)" },
            { "value": "LC3", "label": "LC3 (LE Audio)" }
          ],
          "attribute": "bluetoothCodecs", "storage": "multi", "vocab": ["SBC", "AAC", "aptX", "aptX HD", "aptX Adaptive", "aptX LL", "LDAC", "LC3"]
        },
        {
          "id": "anc", "group": "wireless", "label": "Noise Cancelling", "control": "checkbox",
          "options": [
            { "value": "anc", "label": "Active Noise Cancelling" },
            { "value": "passive", "label": "Passive Isolation Only" },
            { "value": "none", "label": "No Noise Cancelling" }
          ],
          "attribute": "anc", "storage": "enum", "vocab": ["anc", "passive", "none"]
        },
        {
          "id": "batteryLife", "group": "wireless", "label": "Battery Life", "control": "range",
          "min": 0, "max": 70, "unit": "hrs",
          "attribute": "batteryLifeHours.ancOff", "storage": "range", "vocab": ["min", "max"]
        },
        {
          "id": "driverType", "group": "technical", "label": "Driver Type", "control": "checkbox",
          "options": [
            { "value": "dynamic", "label": "Dynamic" },
            { "value": "planar-magnetic", "label": "Planar Magnetic" },
            { "value": "electrostatic", "label": "Electrostatic" },
            { "value": "balanced-armature", "label": "Balanced Armature" },
            { "value": "amt", "label": "AMT / Ribbon (Air-Motion)" }
          ],
          "attribute": "driverType", "storage": "multi", "vocab": ["dynamic", "planar-magnetic", "electrostatic", "balanced-armature", "hybrid", "amt", "bone-conduction", "electret"]
        },
        {
          "id": "driverConfig", "group": "technical", "label": "Driver Configuration", "control": "checkbox",
          "options": [
            { "value": "single-dynamic", "label": "Single Dynamic" },
            { "value": "multi-ba", "label": "Multi Balanced Armature" },
            { "value": "hybrid-config", "label": "Hybrid (Multi-Driver Combo)" },
            { "value": "other", "label": "Other / Unusual Design" }
          ],
          "attribute": "driverConfigBucket", "storage": "enum", "vocab": ["single-dynamic", "single-ba", "multi-ba", "hybrid-config", "planar", "other"]
        }
      ]
    },
