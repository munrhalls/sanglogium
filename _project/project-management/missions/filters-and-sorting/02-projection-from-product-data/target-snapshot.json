    { "id": "awards", "label": "Awards / recognition", "attribute": "awards", "storage": "multi", "vocab": ["<award-slug>"], "categories": ["headphones"] },
    { "id": "condition", "label": "Condition", "attribute": "condition", "storage": "enum", "vocab": ["new", "open-box", "refurbished"], "categories": ["audio-electronics"] }
