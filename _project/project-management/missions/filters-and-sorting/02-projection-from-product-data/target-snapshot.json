    "features/product-filtering/core/definitions/categories/accessories.ts",
    "features/product-filtering/core/definitions/sortOptions.ts",
    "features/product-filtering/core/definitions/facetMap.ts"
  ],
  "slices": {
    "headphones": {
      "groups": [
        { "id": "commercial", "label": "" },
        { "id": "type", "label": "" },
        { "id": "sound", "label": "Sound Properties" },
        { "id": "material", "label": "Material Factors" },
        { "id": "wireless", "label": "Wireless" },
        { "id": "technical", "label": "Technical Specs" }
      ],
      "facets": [
        {
          "id": "brand", "group": "commercial", "label": "Brand", "control": "checkbox",
          "options": "derived",
          "attribute": "brand", "storage": "multi", "vocab": ["<brand-slug>"]
        },
        {
          "id": "inStock", "group": "commercial", "label": "In Stock Only", "control": "boolean",
          "attribute": "inStock", "storage": "boolean", "vocab": ["true", "false"]
        },
        {
          "id": "acousticDesign", "group": "type", "label": "Acoustic Design", "control": "checkbox",
          "options": [
            { "value": "open-back", "label": "Open-Back" },
            { "value": "closed-back", "label": "Closed-Back" },
            { "value": "semi-open", "label": "Semi-Open / Hybrid" }
          ],
          "attribute": "acousticDesign", "storage": "multi", "vocab": ["open-back", "closed-back", "semi-open"]
        },
        {
          "id": "connectivity", "group": "type", "label": "Connectivity", "control": "checkbox",
          "options": [
            { "value": "wired", "label": "Wired" },
            { "value": "wireless", "label": "Wireless (Bluetooth)" },
            { "value": "hybrid", "label": "Wired + Wireless Hybrid" }
          ],
          "attribute": "connectivity", "storage": "enum", "vocab": ["wired", "wireless", "true-wireless", "hybrid"]
        },
        {
          "id": "soundSignature", "group": "sound", "label": "Signature", "control": "checkbox",
          "options": [
            { "value": "Neutral", "label": "Neutral" },
            { "value": "Warm", "label": "Warm" },
            { "value": "Bright/Analytical", "label": "Bright / Analytical" },
