### Copy Catalogue Index

```bash
cp ../sang-logium/data/catalogue-index.json config/
```

### Create Core Types

```typescript
// src/lib/types.ts
export interface ScrapePlan {
  planId: string;
  source: {
    name: string;
    baseUrl: string;
    type: 'manufacturer' | 'retailer' | 'api';
  };
  target: {
    catalogueSlug: string;
    catalogueId: string;
  };
  selectors: {
    productList: string;
    productName: string;
    productPrice: string;
    productImage: string;
    productUrl: string;
    nextPage?: string;
  };
  constraints: {
    maxProducts: number;
    rateLimit: number;
    maxPages: number;
  };
  status: 'pending' | 'approved' | 'rejected';
}

export type BatchStatus =
  | 'scraped'        // Raw data, needs transform
  | 'transformed'    // Transformed, needs review
  | 'reviewed'       // Decisions made, needs upload
  | 'uploaded';      // Complete

export interface ScrapedBatch {
  batchId: string;
  planId: string;
  scrapedAt: string;
  status: BatchStatus;
  products: ScrapedProduct[];
  metadata: {
    productsFound: number;
    productsScraped: number;
    errors: number;
  };
}

export interface ScrapedProduct {
  _scrapedId: string;
  sourceUrl: string;
  sourceId: string;
  raw: {
    name: string;
    price: string;
    image: string;
    description?: string;
    specifications?: Record<string, string>;
    [key: string]: any;
  };
  transformed?: TransformedData;
  validation?: ValidationResult;
  decision?: 'approve' | 'reject' | 'skip';
}

export interface TransformedData {
  name: string;
  slug: string;
  sku: string;
  displayPrice: number;
  brand: {
    sourceName: string;
    sanityBrandId?: string;
    isNewBrand: boolean;
  };
  catalogueLocationKeys: string[];
  stripePriceId: string;
  image: {
    sourceUrl: string;
    localPath?: string;
    sanityAssetId?: string;
  };
  description?: string;
  specifications?: Array<{title: string; value: string}>;
  overviewFields?: Array<{title: string; value: string; information?: string}>;
}

export interface ValidationResult {
  hasRequiredFields: boolean;
  missingFields: string[];
  brandExists: boolean;
  skuIsUnique: boolean;
  imageExists: boolean;
  overall: 'ready' | 'needs_review';
}
```

