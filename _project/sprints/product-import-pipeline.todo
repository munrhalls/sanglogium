### CLI: Approve Plan

```typescript
// src/plan/approvePlan.ts
export async function approvePlan(planId: string): Promise<void> {
  const planPath = `plans/${planId}.plan.json`;
  const plan = JSON.parse(await fs.readFile(planPath, 'utf-8'));

  plan.status = 'approved';
  plan.approvedAt = new Date().toISOString();

  await fs.writeFile(planPath, JSON.stringify(plan, null, 2));
  console.log(`Plan ${planId} approved`);
}
```

