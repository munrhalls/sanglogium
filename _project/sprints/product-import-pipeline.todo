## Phase 4: Transform Stage (Day 3-4)

### Transform Engine

```typescript
// src/transform/transformBatch.ts
import { ScrapedBatch, ScrapedProduct, TransformedData, ValidationResult } from '../lib/types';
import { loadCatalogueIndex } from '../lib/catalogueIndex';
import { loadBrands, resolveBrand } from '../lib/brands';
import { sanityClient } from '../lib/sanityClient';
import { slugify } from '../lib/utils';
import * as fs from 'fs/promises';

// Transform with brand cache (simple exact match)
export async function transformBatch(batch: ScrapedBatch): Promise<ScrapedBatch> {
  const catalogueIndex = await loadCatalogueIndex();
  const plan = await loadPlan(batch.planId);

  // Load brands once for all products (G-13 fix)
  const brandCache = await loadBrands();

  for (const product of batch.products) {
    product.transformed = await transformProduct(product, plan, catalogueIndex, brandCache);
    product.validation = await validateProduct(product);
  }

  batch.status = 'transformed';

  // Save transformed batch inline (no separate transformed/ directory)
  await fs.writeFile(
    `scraped/${batch.planId}/${batch.batchId}.json`,
    JSON.stringify(batch, null, 2)
  );

  return batch;
}

async function transformProduct(
  product: ScrapedProduct,
  plan: ScrapePlan,
  catalogueIndex: any,
  brandCache: Map<string, string>
): Promise<TransformedData> {
  const raw = product.raw;

  // Parse price
  const priceMatch = raw.price.match(/[\d,]+\.?\d*/);
  const displayPrice = priceMatch ? parseFloat(priceMatch[0].replace(',', '')) : 0;

  // Resolve brand (simple exact match from cache)
  const brandName = raw.brand || raw.name.split(' ')[0];
  const brandResolution = await resolveBrand(brandName, brandCache);

  // Generate SKU
  const sku = generateSKU(raw.name, product.sourceId);

  return {
    name: raw.name.trim(),
    slug: slugify(raw.name),
    sku,
    displayPrice,
    brand: {
      sourceName: brandName,
      sanityBrandId: brandResolution.id || undefined,
      isNewBrand: brandResolution.isNew
    },
    catalogueLocationKeys: [plan.target.catalogueId],
    stripePriceId: 'PENDING_MANUAL_SETUP',
    image: {
      sourceUrl: raw.image,
      localPath: `scraped/${plan.planId}/images/${product.sourceId}-source.jpg`
    },
    description: raw.description,
    specifications: raw.specifications ?
      Object.entries(raw.specifications).map(([title, value]) => ({ title, value })) :
      undefined
  };
}

async function validateProduct(product: ScrapedProduct): Promise<ValidationResult> {
  const t = product.transformed!;
  const missingFields: string[] = [];

  if (!t.name || t.name.length < 2) missingFields.push('name');
  if (!t.displayPrice || t.displayPrice <= 0) missingFields.push('price');
  if (!t.sku) missingFields.push('sku');
  if (!t.image.localPath) missingFields.push('image');

  // Simple brand check (exact match only)
  const brandExists = !!t.brand.sanityBrandId;

  // Check SKU uniqueness against Sanity
  const skuIsUnique = !(await checkSkuExists(t.sku));

  // Check image exists
  const imageExists = await fs.access(t.image.localPath).then(() => true).catch(() => false);

  const needsReview = missingFields.length > 0 || !brandExists || !skuIsUnique || !imageExists;

  return {
    hasRequiredFields: missingFields.length === 0,
    missingFields,
    brandExists,
    skuIsUnique,
    imageExists,
    overall: needsReview ? 'needs_review' : 'ready'
  };
}

function generateSKU(name: string, sourceId: string): string {
  const prefix = name.slice(0, 3).toUpperCase().replace(/[^A-Z]/g, '');
  const suffix = sourceId.slice(-4).toUpperCase();
  return `${prefix}-${suffix}`;
}

// src/lib/brands.ts
import { sanityClient } from './sanityClient';

let brandCache: Map<string, string> | null = null;

export async function loadBrands(): Promise<Map<string, string>> {
  if (brandCache) return brandCache;

  // Simple exact match only - no fuzzy matching (G-01 fix)
  const brands = await sanityClient.fetch(`
    *[_type == "brand"]{_id, name}
  `);

  brandCache = new Map<string, string>();
  for (const b of brands) {
    brandCache.set(b.name.toLowerCase(), b._id);
  }
  return brandCache;
}

export async function resolveBrand(
  name: string,
  brandCache: Map<string, string>
): Promise<{id: string; isNew: boolean}> {
  const match = brandCache.get(name.toLowerCase());
  if (match) {
    return { id: match, isNew: false };
  }
  return { id: '', isNew: true };
}
```

