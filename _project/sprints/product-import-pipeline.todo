## Phase 3: Scrape Stage (Day 2-3)

### Playwright Scraper

```typescript
// src/scrape/executePlan.ts
import { chromium, Page } from 'playwright';
import { ScrapePlan, ScrapedBatch, ScrapedProduct } from '../lib/types';
import * as fs from 'fs/promises';
import * as path from 'path';

export async function executePlan(plan: ScrapePlan): Promise<ScrapedBatch> {
  const browser = await chromium.launch({ headless: true });
  const context = await browser.newContext({
    userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
  });

  const products: ScrapedProduct[] = [];
  let currentPage = 1;

  try {
    const page = await context.newPage();

    // Navigate to source
    await page.goto(plan.source.baseUrl, { waitUntil: 'networkidle' });

    while (products.length < plan.constraints.maxProducts && currentPage <= plan.constraints.maxPages) {
      // Wait for products to load
      await page.waitForSelector(plan.selectors.productList, { timeout: 10000 });

      // Extract product data
      const pageProducts = await page.evaluate((selectors) => {
        const items = document.querySelectorAll(selectors.productList);
        return Array.from(items).map((item, index) => {
          const nameEl = item.querySelector(selectors.productName);
          const priceEl = item.querySelector(selectors.productPrice);
          const imageEl = item.querySelector(selectors.productImage) as HTMLImageElement;
          const urlEl = item.querySelector(selectors.productUrl) as HTMLAnchorElement;

          return {
            _scrapedId: `raw-${index}`,
            sourceUrl: urlEl?.href || '',
            sourceId: urlEl?.href?.split('/').pop() || `unknown-${index}`,
            raw: {
              name: nameEl?.textContent?.trim() || '',
              price: priceEl?.textContent?.trim() || '',
              image: imageEl?.src || '',
              brand: item.querySelector(selectors.productBrand)?.textContent?.trim() || ''
            }
          };
        });
      }, plan.selectors);

      products.push(...pageProducts);

      // Rate limiting
      await sleep(plan.constraints.rateLimit);

      // Next page
      const nextPageEl = await page.$(plan.selectors.nextPage);
      if (nextPageEl) {
        await nextPageEl.click();
        await page.waitForNavigation({ waitUntil: 'networkidle' });
        currentPage++;
      } else {
        break;
      }
    }
  } finally {
    await browser.close();
  }

  // Generate batch ID: planId + 3-digit counter
  const existingBatches = await fs.readdir(`scraped/${plan.planId}`).catch(() => []);
  const batchCount = existingBatches.filter(f => f.endsWith('.json')).length;
  const batchId = `${plan.planId}-${String(batchCount + 1).padStart(3, '0')}`;

  const batch: ScrapedBatch = {
    batchId,
    planId: plan.planId,
    scrapedAt: new Date().toISOString(),
    status: 'scraped',
    products: products.slice(0, plan.constraints.maxProducts),
    metadata: {
      productsFound: products.length,
      productsScraped: Math.min(products.length, plan.constraints.maxProducts),
      errors: 0
    }
  };

  // Save batch
  await fs.writeFile(
    `scraped/${plan.planId}/${batchId}.json`,
    JSON.stringify(batch, null, 2)
  );

  return batch;
}
```

