## Phase 2: Plan Stage (Day 1-2)

### Create Plan Manager

```typescript
// src/plan/createPlan.ts
import { ScrapePlan } from '../lib/types';
import { slugify } from '../lib/utils';
import * as fs from 'fs/promises';
import * as path from 'path';

export async function createPlan(
  sourceName: string,
  sourceUrl: string,
  catalogueSlug: string,
  selectors: ScrapePlan['selectors']
): Promise<ScrapePlan> {

  // Load catalogue index
  const catalogueIndex = await loadCatalogueIndex();
  const catalogueId = catalogueIndex.slugToIdMap[catalogueSlug];

  if (!catalogueId) {
    throw new Error(`Unknown catalogue slug: ${catalogueSlug}`);
  }

  const plan: ScrapePlan = {
    planId: `${slugify(sourceName)}-${catalogueSlug}-${new Date().toISOString().slice(0, 10)}`,
    source: {
      name: sourceName,
      baseUrl: sourceUrl,
      type: 'manufacturer'
    },
    target: {
      catalogueSlug,
      catalogueId
    },
    selectors,
    constraints: {
      maxProducts: 10,
      rateLimit: 1000,
      maxPages: 2
    },
    status: 'pending'
  };

  // Save plan
  await fs.writeFile(
    path.join('plans', `${plan.planId}.plan.json`),
    JSON.stringify(plan, null, 2)
  );

  return plan;
}
```

