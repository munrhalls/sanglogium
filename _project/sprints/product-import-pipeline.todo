## Phase 6: Upload Stage (Day 5-6)

### Sanity Upload

```typescript
// src/upload/executeUpload.ts
import { createClient } from '@sanity/client';
import { ScrapedBatch, ScrapedProduct } from '../lib/types';
import * as fs from 'fs/promises';
import * as path from 'path';

const sanityClient = createClient({
  projectId: process.env.SANITY_PROJECT_ID!,
  dataset: process.env.SANITY_DATASET || 'production',
  token: process.env.SANITY_API_TOKEN!,
  apiVersion: '2024-01-01',
  useCdn: false
});

export async function uploadBatch(
  batch: ScrapedBatch,
  dryRun: boolean = false
): Promise<void> {
  const approved = batch.products.filter(p => p.decision === 'approve');

  console.log(`\nUploading batch: ${batch.batchId}`);
  console.log(`Approved products: ${approved.length}`);

  if (dryRun) {
    console.log('DRY RUN - no changes will be made');
    for (const product of approved) {
      console.log(`  Would create: ${product.transformed!.name}`);
    }
    return;
  }

  // Step 1: Create new brands
  const newBrands = approved.filter(p => p.transformed!.brand.isNewBrand);
  for (const product of newBrands) {
    const brand = await sanityClient.create({
      _type: 'brand',
      name: product.transformed!.brand.sourceName,
      slug: { current: slugify(product.transformed!.brand.sourceName) }
    });
    product.transformed!.brand.sanityBrandId = brand._id;
    console.log(`Created brand: ${brand.name} (${brand._id})`);
  }

  // Step 2: Upload images
  for (const product of approved) {
    const imagePath = product.transformed!.image.localPath!;
    const imageBuffer = await fs.readFile(imagePath);

    const asset = await sanityClient.assets.upload('image', imageBuffer, {
      filename: path.basename(imagePath)
    });

    product.transformed!.image.sanityAssetId = asset._id;
    console.log(`Uploaded image: ${asset._id}`);
  }

  // Step 3: Create products
  const created: Array<{sourceId: string; sanityId: string}> = [];

  for (const product of approved) {
    const t = product.transformed!;

    const sanityProduct = {
      _type: 'product',
      name: t.name,
      slug: { current: t.slug },
      sku: t.sku,
      displayPrice: t.displayPrice,
      stripePriceId: 'PENDING_MANUAL_SETUP',
      brand: { _type: 'reference', _ref: t.brand.sanityBrandId! },
      catalogueLocationKeys: t.catalogueLocationKeys,
      image: {
        _type: 'image',
        asset: { _type: 'reference', _ref: t.image.sanityAssetId! }
      },
      description: t.description,
      specifications: t.specifications,
      overviewFields: t.overviewFields
    };

    const createdProduct = await sanityClient.create(sanityProduct);
    console.log(`Created product: ${createdProduct.name} (${createdProduct._id})`);

    created.push({
      sourceId: product._scrapedId,
      sanityId: createdProduct._id
    });
  }

  // Save upload report
  await fs.writeFile(
    `uploads/${batch.batchId}-upload.json`,
    JSON.stringify({
      batchId: batch.batchId,
      uploadedAt: new Date().toISOString(),
      productsCreated: created.length,
      products: created,
      nextSteps: [
        `1. Create Stripe products for ${created.length} products`,
        '2. Update stripePriceId in Sanity Studio',
        '3. Run image pipeline for background removal'
      ]
    }, null, 2)
  );
}
```

### CLI: Upload

```typescript
// scripts/upload.ts
import { loadBatch } from '../src/lib/loadBatch';
import { uploadBatch } from '../src/upload/executeUpload';

async function main() {
  const batchId = process.argv[2];
  const dryRun = process.argv.includes('--dry-run');

  const batch = await loadBatch(batchId, 'validation');

  await uploadBatch(batch, dryRun);

  if (!dryRun) {
    console.log('\nUpload complete!');
    console.log('Next: Create Stripe products and update stripePriceId');
  }
}

main();
```

