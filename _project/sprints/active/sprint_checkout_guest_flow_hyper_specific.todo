# Sprint: Checkout Guest Flow — End-to-End (Hyper-Specific) v2
# Date: 2026-04-11 (rev 2026-04-11) | Source: Live codebase + post-execution bug audit
# All file:line references confirmed against ACTUAL implemented code (post-SC1/SC2 execution).
# v2 CHANGES: 4 critical bugs found in SC2 implementation + Redis cold-start gap + SC3 formula bug

# ═══════════════════════════════════════════════════════════════════
# UX FLOWS — BUS STOPS (IMMUTABLE)
# ═══════════════════════════════════════════════════════════════════

# A. MAIN PATH:
#   /basket → click Checkout → /checkout/address?sessionId=X&idempotencyKey=X
#   Fill address → submit → /checkout/payment?sessionId=X
#   Fill PaymentElement → Pay → /checkout/success (basket cleared)

# B. IDEMPOTENCY RETRY:
#   Resubmit address with same idempotencyKey → Redis cache HIT → same PI returned, no new reservation

# C. PAYMENT FAILURE:
#   Declined card → error on payment page → FSM idle + errorMessage → user retries same PI

# D. EXPIRY:
#   Abandon at payment → Redis TTL 15min auto-releases stock → webhook handles payment_failed

# ═══════════════════════════════════════════════════════════════════
# ARCHITECTURE CONTRACT
# ═══════════════════════════════════════════════════════════════════

# BASKET: CHECKOUT_CLICK
#   idle → processing
#   Client only: crypto.randomUUID() → idempotencyKey | getOrCreateGuestSession() → sessionId cookie
#   validateBasketLocally() guard | router.push('/checkout/address?sessionId=X&idempotencyKey=X')

# ADDRESS: ADDRESS_SUBMIT
#   idle → processing
#   reserveStock(SA): Redis idempotency check → Sanity price+stock validation (fetches products[])
#   → For each basket item:
#       1. Redis HGET product_stock:itemId
#       2. COLD MISS (null): seed Redis from sanityProducts[i].stock (already fetched)
#       3. If stock < quantity: restore all previously-decremented items → return INSUFFICIENT_STOCK
#       4. Redis HINCRBY product_stock:itemId -quantity | track in reserved[]
#   → Store reservation JSON array AFTER all items reserved (NOT before)
#   → Stripe PI create(PLN, options: { idempotencyKey: `pi_${key}` })
#   → On Stripe failure: rollbackReservation (parses JSON array, restores ALL items)
#   → Redis SET guest_session:${sessionId} = { paymentIntentId, clientSecret, reservationId, expiresAt, amountPln }
#      NOTE: amountPln = totalAmount / 100 (PLN, not grosze)
#   → Redis SET idempotency:${key} = { clientSecret, reservationId, expiresAt }
#   On success: router.push('/checkout/payment?sessionId=X')

# PAYMENT: page mount → getGuestSession(sessionId) → clientSecret resolved
#   PAYMENT_SUBMIT: idle → processing
#   elements.submit() → stripe.confirmPayment({ redirect: 'if_required' })
#   Card success (no redirect): router.push('/checkout/success?payment_intent=${paymentIntent.id}')
#   3DS: Stripe redirects to return_url → /checkout/success?payment_intent=X
#   NOTE: ALWAYS pass payment_intent ID — eliminates Case B unauthenticated access

# WEBHOOK: /api/webhooks/stripe
#   payment_intent.succeeded: verify sig → idempotency guard → create Sanity order (ALL items) → mark processed
#   payment_intent.payment_failed/canceled: verify sig → idempotency guard → releaseReservation → clear session

# FSM (source: store/checkout/checkoutMachine.ts — DO NOT create alternate):
#   { status: 'idle'|'processing'|'complete', errorMessage, idempotencyKey,
#     clientSecret, reservationId, expiresAt } : CheckoutContext

