## Testing Strategy

### Unit Tests (Vitest)
```typescript
// tests/unit/vfs/unrollDescendantKeys.test.ts
describe("unrollDescendantKeys", () => {
  it("returns leaf node ID for leaf nodes", () => {
    const leafId = "o7c6baiuobsr7ni2y2vf22sh";
    const result = unrollDescendantKeys(leafId);
    expect(result).toContain(leafId);
    expect(result.length).toBeGreaterThanOrEqual(1);
  });

  it("returns all descendants for header nodes", () => {
    const headerId = "ugyeto8653n495dpf89nzoar"; // Headphones
    const result = unrollDescendantKeys(headerId);
    expect(result.length).toBeGreaterThan(1);
    // Should include leaf nodes
    expect(result).toContain("o7c6baiuobsr7ni2y2vf22sh"); // Open-Back
  });

  it("handles missing IDs gracefully", () => {
    const result = unrollDescendantKeys("nonexistent-id");
    expect(result).toEqual(["nonexistent-id"]);
  });
});
```

### Integration Tests
```typescript
// tests/integration/catalogue-to-products.test.ts
describe("Catalogue to Products Integration", () => {
  it("clicking Open-Back shows open-back products", async () => {
    const slug = "open-back";
    const id = resolveSlugToId(slug);
    expect(id).toBeDefined();

    const keys = unrollDescendantKeys(id!);
    expect(keys.length).toBeGreaterThan(0);

    const result = await getSelectedProducts(keys, [], [], { page: 1, pageSize: 12 });
    expect(result.products.length).toBeGreaterThan(0);
  });
});
```

