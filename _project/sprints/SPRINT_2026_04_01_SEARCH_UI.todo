## SC2: Pass 2 — GROQ Search Query + Data Flow [G-01]

### Files
# sanity/lib/products/searchProducts.ts

### Target State
# Working GROQ queries that return real product data from Sanity.
# Two exported functions with proper TypeScript types.

### GROQ Query Design (VERIFIED against schema 2026-04-01)
#
# Schema verification:
#   - name: string (productType.ts line 13-16) ✅
#   - brand: reference to brand document (productType.ts line 35-39) ✅
#     → brand->name is CORRECT (reference traversal)
#   - sku: string (productType.ts line 64-67) ✅
#   - displayPrice: number (productType.ts line 49-54) ✅
#   - slug: slug type (productType.ts line 24-32) ✅
#   - image: image type (productType.ts line 69-76) ✅
#   - stock: number (productType.ts line 56-60) ✅
#
# Autocomplete query (max 6 results):
#   *[_type == "product" && (
#     name match $query ||
#     brand->name match $query ||
#     sku match $query
#   )] | order(name asc) [0...6] {
#     _id, name, "brand": brand->name, displayPrice,
#     slug { current }, image
#   }
#
# Full results query (all matches, sortable):
#   *[_type == "product" && (
#     name match $query ||
#     brand->name match $query ||
#     sku match $query
#   )] | order($orderClause) {
#     _id, name, "brand": { "name": brand->name }, displayPrice,
#     stock, slug { current }, image
#   }
#
# Parameters:
#   - $query: "${userInput}*" (append wildcard for prefix matching)
#   - Guard: minimum 2 characters
#   - Sort: name asc (default), name desc, displayPrice asc, displayPrice desc

### Shared Type (exported from this file — single source of truth)
# export interface SearchProduct {
#   _id: string;
#   name: string;
#   brand: { name: string } | null;
#   displayPrice: number;
#   stock: number;
#   slug: { current: string };
#   image: any;
# }
#
# export interface AutocompleteProduct {
#   _id: string;
#   name: string;
#   brand: string | null;
#   displayPrice: number;
#   slug: { current: string };
#   image: any;
# }

### DoD
# - [ ] SearchProduct and AutocompleteProduct types exported
# - [ ] searchProductsAutocomplete(query: string) → Promise<AutocompleteProduct[]>
#       Uses sanityFetch, appends "*" wildcard, returns max 6, guards <2 chars
# - [ ] searchProductsFull(query: string, sort?: string) → Promise<SearchProduct[]>
#       Uses sanityFetch, appends "*" wildcard, supports sort param, guards <2 chars
# - [ ] Both functions use groq template literal (import groq from 'groq')
# - [ ] Both functions follow sanityFetch pattern from sanity/lib/client.ts
# - [ ] Verify: npm run build passes
# - [ ] Verify: Import in search/page.tsx, call with real query, confirm data returns

### Delegation
# /implement SC2 from SPRINT_2026_04_01_SEARCH_UI
# Build gate: npm run build

## SC3: Pass 2 — Search Results Page Data Integration [G-02, G-07]

### Files
# app/(store)/search/page.tsx
# app/components/features/search/SearchHeader.tsx

### Target State
# Server Component reads searchParams.q, calls searchProductsFull(),
# passes real products to existing ProductGrid component.
# SearchHeader shows breadcrumb + query text (unstyled).

### Architecture (follows suspense-streaming pattern)
# page.tsx:
#   - Read searchParams.q and searchParams.sort
#   - Guard: if no q or empty q, show message
#   - Create productsPromise = searchProductsFull(q, sort)
#   - Render SearchHeader (sync — just text)
#   - Render Suspense > ProductsSection with productsPromise
#
# SearchHeader:
#   - Props: query (string)
#   - Renders breadcrumb: Home / Search
#   - Renders overline: "Search Results"
#   - Renders h1: query text (uppercased)

### DoD
# - [ ] page.tsx reads searchParams.q, searchParams.sort
# - [ ] page.tsx calls searchProductsFull(q, sort)
# - [ ] page.tsx renders SearchHeader with query prop
# - [ ] page.tsx renders SortDropdown + result count (unstyled)
# - [ ] page.tsx renders ProductGrid with real search results
# - [ ] page.tsx renders SearchEmpty when results.length === 0
# - [ ] SearchHeader renders breadcrumb + overline + h1 with query (unstyled)
# - [ ] Verify: npm run build passes
# - [ ] Verify: /search?q=headphone shows real matching products

### Delegation
# /implement SC3 from SPRINT_2026_04_01_SEARCH_UI
