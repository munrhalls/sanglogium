## SC10: Search Results Page — Suspense + Skeleton Polish [Streaming pattern]

### Files
# app/(store)/search/page.tsx

### Target State
# Search results wrapped in Suspense with ProductGridSkeleton fallback.
# Follows suspense-streaming-components pattern from lessons.

### Architecture
# page.tsx:
#   const productsPromise = searchProductsFull(q, sort);
#   return (
#     <div className="...container...">
#       <SearchHeader query={q} />
#       <Suspense fallback={<ProductGridSkeleton />}>
#         <SearchResultsSection productsPromise={productsPromise} query={q} />
#       </Suspense>
#     </div>
#   )
#
# SearchResultsSection (new async component in same route folder):
#   export async function SearchResultsSection({ productsPromise, query }) {
#     const products = await productsPromise;
#     if (products.length === 0) return <SearchEmpty query={query} />;
#     return (
#       <>
#         <SortBar count={products.length} />
#         <ProductGrid products={products} className="..." />
#       </>
#     );
#   }

