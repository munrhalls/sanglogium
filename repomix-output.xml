            />
          </div>
          <ProductName name={product.name} />
          <Price price={product.price} priceColor="#50C878" />
        </Link>
      </div>
    );
  });
  return (
    <div className="grid w-full grid-rows-[1fr_4fr]">
      <SegmentTitle title="Wireless Earbuds" />
