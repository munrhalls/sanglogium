      type: "string",
      validation: (Rule) => Rule.required(),
    }),
    defineField({
      name: "subhead",
      title: "Subhead (Markdown supported)",
      type: "text",
      rows: 5,
    }),
    defineField({
      name: "ctaText",
      title: "CTA Button Text",
      type: "string",
      initialValue: "Shop Now",
    }),
    defineField({
      name: "ctaLink",
      title: "CTA Destination URL",
      type: "url",
      validation: (Rule) =>
        Rule.uri({
          scheme: ["http", "https", "mailto", "tel"],
