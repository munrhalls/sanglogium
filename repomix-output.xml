        "_type": "overviewField",
        "_key": "14e03a3e-4301-43a7-9b27-8be6d23df7b7",
        "title": "Want To Spin a Record?",
        "value": "The MyConnect 250 is compatible with all read head technologies. You'll find settings for MM, low-level MC and high-level MC coils.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "8722a308-8e9d-415c-be3f-4279e0cbaca3",
        "title": "Spotify &amp; More",
        "value": "MyConnect 250 is SPOTIFY Connect compatible. You can choose your amplifier as a music player directly in the SPOTIFY application.",
