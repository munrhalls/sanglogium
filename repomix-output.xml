    "overviewFields": [
      {
        "_type": "overviewField",
        "_key": "b78c8db8-4bc2-4fb1-8353-3e5a6183b30a",
        "title": "Designed to play loud &amp; clear. Sized to fit anywhere.",
        "value": "Sized to fit anywhere, the DN8 performs bigger, louder, and clearer than other 8” subwoofers. Its unique 3XR™ Architecture creates three times the radiating surface area of similarly sized subs, providing more bass. And because it uses passive bass radiators, you get that big, thrilling bass with no port noise distortion.",
        "information": "Main Overview"
      },
      {
        "_type": "overviewField",
        "_key": "4d25f0a9-3ff5-40ad-b829-0c4b353b898f",
        "title": "3XR Architecture for Loud &amp; Clear Bass",
        "value": "Descend Series subwoofers feature Definitive Technology’s new 3XR™ Architecture, providing three times the bass-producing radiating surface area of a traditional ported subwoofer. This extra surface area moves more air, resulting in massive bass. And because 3XR doesn’t use ports, it also provides crystal-clear lows with no port noise distortion.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "05f39a94-5125-4bc3-9731-d883156d161a",
        "title": "Fits Nearly Everywhere",
        "value": "The DN8 is just over one foot wide, enabling it to fit virtually any room or system. And due to its 3XR™ Architecture, it performs like a 10” subwoofer even though it has an 8” driver. With the DN8, you get tons of bass from a one-foot sub.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "4ecbacb9-3cee-485e-9034-d54b63073844",
        "title": "Custom Class D Digital Amplification",
        "value": "The DN8 is equipped with a 500W peak custom Class D digital amplifier, designed to get the most out of the DN8’s 3XR™ Architecture. This custom amplification gives the Descend DN8 enough power and efficiency to play as low as 35Hz.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "887f8ea4-8eda-46ea-97b9-a4f2a134db51",
        "title": "Control &amp; Customization",
        "value": "You can customize the DN8 to the needs of your own application, system, and space. The DN8 features built-in controls to dial in volume, low-pass filter, and phase (0/180°) for optimum bass levels. Set its power toggle to Auto on/off or DC control for fast and easy on/off power switching.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "b9331e0f-5bf0-4356-824b-33cbd326c9c9",
        "title": "Connects to Any System",
        "value": "The DN8 delivers deep, dynamic bass to any home theater or music system. Easily connect it via LFE or stereo line-level RCA inputs (cables not included).",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "f54dd541-3962-4816-9fdc-7a832ed72540",
        "title": "Pair Multiple Subwoofers for Optimal Performance",
        "value": "While a single subwoofer adds bass and enhanced realism to any system, it may not provide consistent frequency response throughout the room. Properly using multiple subwoofers designed to be used together like the DN8 flattens the frequency response. The result is smoother bass throughout the room, helping eliminate boomy locations or dead spots.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "09cbcfc7-f44d-477e-9ee4-e9080a7696d8",
        "title": "Three Decades of Thrilled Customers",
        "value": "Definitive Technology has been thrilling movie and music enthusiasts for decades with high-performance, high-value subwoofers that consistently deliver deep, impactful, dynamic bass to home theater and music systems.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "e89680a5-18e3-4982-9031-063e98951050",
        "title": "Limited Warranty, Built to Last",
        "value": "Manufactured under the strictest quality controls, Definitive Technology speakers and subwoofers are built for the long haul. All Definitive Technology products come with a limited warranty (1 year on amplifier, 2 years on driver).",
        "information": "Product Feature"
      },
