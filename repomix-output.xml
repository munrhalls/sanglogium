      {
        "_type": "overviewField",
        "_key": "b630d55b-ecc0-436b-b8da-44c111b75e37",
        "title": "Tune Into Nashville’s Soul with Powerful Sound Performance",
        "value": "The Klipsch Nashville features dual 2.25” full-range drivers for 360° audio while dual passive radiators provide deep, resonating bass. While small in stature, the Nashville’s exceptional engineering provides deep bass and clear vocals for superior audio performance on the go.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "06e66b43-c7fb-4c6f-802f-17960e537bdc",
        "title": "Plenty Of Power For A Long Night Of Honky Tonkin’",
        "value": "This small-but-mighty Bluetooth speaker can last up to 24 hours on a single charge. Whether you’re traversing Music City’s streets or taking a long ride outta town, the Klipsch Nashville’s long-lasting battery has you covered.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "b5ac77fd-7836-4e79-8d78-ffc7a94b62c9",
        "title": "Rugged As Blue Ridge, Smooth Like The Mississippi",
        "value": "Enjoy IP67 dust and waterproof rating with this travel-ready Bluetooth speaker. The Klipsch Nashville is completely protected from dust and submergible up to one meter for 30 minutes.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "291dc6bc-9800-4669-a6cd-389be0c1052e",
        "title": "Best Bluetooth Connectivity Tech On The Market Today",
        "value": "Wireless connectivity is a must-have for your on-the-go lifestyle. That’s why the Klipsch Nashville features Bluetooth 5.3 true wireless technology for seamless stereo playback. This portable speakers remembers up to 8 devices for ultimate playlist flexibility and control.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "663bbb95-123f-4716-b778-3b477c19ebe2",
        "title": "Charged Up for The Modern World",
        "value": "Enjoy 18W USB-C charging for fast, effective powering while reverse USB-C charge functionality (10W) lets you pull on some of that energy in a pinch to recharge your smartphone or other mobile device.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "0b48bbfe-ef69-4fe9-985d-a28776e154d2",
        "title": "Better With Friends: Broadcast Mode",
        "value": "Party people, pay attention – the Klipsch Nashville featured broadcast mode to allow playback on up to 10+ Klipsch speakers at once! Just put the desired speakers into broadcast pairing mode while audio is playing and enjoy mono signals being sent to the added devices.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "8f569259-8b71-4cb5-914b-bc883defea6c",
        "title": "Built-In Microphone for Calls",
        "value": "Plans change, and maybe your solo hike has turned into a group hang on Broadway Street. You won’t miss a beat with the Klipsch Nashville’s built-in microphone, allowing you to pause on your music to take a quick call, all without having to search for your cellphone first.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "db4f0f64-15f7-4d16-9024-1d1b8043d160",
        "title": "Klipsch Connect App Enabled",
        "value": "With just a tap on your Klipsch Connect app (available for free in the app store), you can custom EQ settings for your ideal bass, mid-range, and treble, receive over-the-air firmware updates, and receive access to support.",
        "information": "Product Feature"
      },
