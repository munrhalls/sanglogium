    "overviewFields": [
      {
        "_type": "overviewField",
        "_key": "94ae3cba-3d27-490d-8ad9-22ad38958dba",
        "title": "Features:",
        "value": "High-Resolution Compact Bookshelf or Surround Speaker, Enjoy Movies, Games, and Music with Exciting and Dynamic Sound, Hi-Res Audio Certified, Dolby Atmos, and DTS:X Compatible, 1” Terylene Tweeter for Crystal Clear Highs Above 40kHz, 5.25” Dynamically Balanced Woofer for Effortless Bass Below 48Hz, Lifelike, Detailed Imaging and Immersive Soundstage, High Sensitivity to Work with 4- and 8-Ohm Amps/Receivers, Easy Set-Up and Placement on Shelf, Stand, or Wall (via keyhole slots), Low-Resonance Cabinet and Precision-Fit Grille, Polk-Patented Quality Backed by Limited Five-Year Warranty, Sold in Pairs",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "d27759e9-65b5-4483-a23d-ccbc181761f0",
        "title": "The Evolution of a Hi-Fi Classic",
        "value": "With a history going back to 1974, the Monitor XT series is the next generation of Polk’s critically acclaimed Monitor line of speakers, now featuring Hi-Res Audio Certification and a new tweeter, woofer, and cabinet designs to improve the sound of anything you’re listening to.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "a52b0670-bbd3-4b57-ac8e-06324906de15",
        "title": "Hi-Res Audio Certified",
        "value": "Monitor XT15’s new Terylene dome tweeter makes them perfect for enjoying high-resolution audio from Apple Music, Tidal, Amazon Music HD, Qobuz, and Spotify HiFi.",
        "information": "Product Feature"
      },
