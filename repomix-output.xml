    ],
    "overviewFields": [
      {
        "_type": "overviewField",
        "_key": "3488cb2d-3298-49ee-9e73-4870c37983aa",
        "title": "Take Your Show on The Road",
        "value": "Record, stream, and create content from anywhere. The JBL Quantum Stream Wireless with USB-C dongle for Android and the latest Apple* devices is a versatile, agile microphone with an omnidirectional pattern that picks up high quality sound from every direction. The lightweight, clip-on design is convenient and comfortable. Yet it still delivers clear recordings with adjustable environmental noise cancelling and the optional furry windshield for windy conditions. Adjustable mic gain makes it easy to record in any environment, and a mute button with an LED indicator means you’ll never forget when you’re not on-mic. All this, plus it’s compatible with the powerful JBL Headphones app so you can fully customize how you sound. Take your show on the road with the JBL Quantum Stream Wireless.",
        "information": "Main Overview"
      },
      {
        "_type": "overviewField",
        "_key": "4e8e658b-453e-40c0-92f5-51bde442d386",
        "title": "Feature",
        "value": "Plug and play",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "11660655-774e-4fc4-b3ee-a83cdea94053",
        "title": "Feature",
        "value": "Crystal clear recordings",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "08875caf-1054-4e81-a7ed-8baa9725292b",
        "title": "Feature",
        "value": "Adjustable mic gain",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "6b3a0c02-a6b1-41b6-9975-a63ece3a178c",
        "title": "Feature",
        "value": "24 hours of recording time, plus speed charge",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "46070990-044e-4bf4-b03a-5ce3eb52ac2d",
        "title": "Feature",
        "value": "Customizable with the JBL Headphones App &amp; JBL QuantumENGINE",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "76680cfa-f1b4-43e1-9b68-3f5b5176ac6d",
        "title": "Feature",
        "value": "Windscreen for noise reduction",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "91eeb4e5-edb3-4f7d-8ba6-acc0e2727491",
        "title": "Feature",
        "value": "Charge while streaming",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "516c2106-bf45-4da0-8b3e-345ef0fad400",
        "title": "Plug And Play",
        "value": "Plug the 2.4Ghz Low Latency Wireless USB-C dongle directly into your Android and the latest Apple* devices and you’re connected. It’s that simple. And feel free to move away from your device, because you have 100 meters of transmission range.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "071753c7-bd30-4dfc-af74-c0f9027f6fec",
        "title": "Crystal Clear Recordings",
        "value": "Be sure your voice will be crisp and defined despite wind and noise. The omnidirectional pick-up pattern with adjustable environmental noise cancelling allows for crips recordings with, or without, ambient sounds.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "2491c8f8-2c80-4aab-922b-6c5819d9c11f",
        "title": "Adjustable Mic Gain",
        "value": "Boost or lower the volume of your voice going into the mic using the JBL Headphones app, and your recordings will sound great whether you’re recording in a library or on a football pitch.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "bdd16b34-a02f-462c-95e0-f482303ec9f0",
        "title": "24 Hours of Recording Time, Plus Speed Charge",
        "value": "Record or broadcast wirelessly for up to 6 hours and get another 18 from the charging case. If you’re in a hurry, a quick 15-minute charge gives you 1 additional recording hour.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "482678eb-4dfe-471e-be38-c823afe20fdc",
        "title": "Customizable with the JBL Headphones App",
        "value": "The JBL Headphones app personalizes your recording experience just for you. Easily customize EQ, gain, noise suppression, auto-off timing, LED brightness, and more right from your Android device.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "47bba170-dc4c-4c37-96eb-cea4558ca1a0",
        "title": "Windscreen For Noise Reduction",
        "value": "The optional windscreen, easy to attach on the go, allows for crystal clear outdoor recordings.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "cd620a22-de79-4cfb-9822-e13cf2e5e718",
        "title": "Reliable Recordings",
        "value": "You’ll always know when you’re connected, when you’re recording, and when the battery needs charging, all thanks to the status lights on the mic and case. You can also dim the LED lights in low-light situations using the JBL Headphones app.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "fcd6b45a-b492-491e-b3b6-e4d1ffbc42bf",
        "title": "Charge While Streaming",
        "value": "You can easily charge your device while streaming, using the additional USB-C port in the dongle.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "f8bcb35a-fe37-4e14-9317-fa1de15d67a2",
        "title": "Compatible with JBL QuantumENGINE",
        "value": "The JBL Quantum Stream Wireless supports the PC software JBL QuantumENGINE so you can quickly adjust EQ and gain to fine-tune your sound, mute and unmute yourself, apply noise reduction, all from your device.",
        "information": "Product Feature"
      },
      {
