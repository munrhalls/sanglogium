        "value": "Crank up the fun with PartyBoost",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "e263f941-1e59-4284-9bd4-342a3600063b",
        "title": "Feature",
        "value": "Power up with the built-in power bank",
        "information": "Features"
      },
      {
        "_type": "overviewField",
        "_key": "e5ad7999-ebf1-4b31-b551-2cca3b79a902",
        "title": "Bold JBL Original Pro Sound",
        "value": "Take the amazing power of JBL Pro Sound with you. The JBL Charge 5 has an optimized long-excursion driver, a separate tweeter, and dual JBL bass radiators, all delivering impressively rich and clear audio. Get that big room sound, even when outdoors.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "82003a72-9ada-4d93-b398-91f40262c529",
        "title": "20 Hours of Playtime",
        "value": "The fun doesn’t have to stop. Packed with an incredible 20 hours of battery life, JBL Charge 5 lets you party all day and into the night.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "ed2ee418-ab80-4de4-a3b2-0cda8494b722",
        "title": "IP67 Waterproof and Dustproof",
        "value": "To the pool. To the park. JBL Charge 5 is IP67 waterproof and dustproof, so you can bring your speaker anywhere.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "9eca0c2c-f7be-4113-b3d4-68c8e40da5a5",
        "title": "Wireless Bluetooth Streaming",
        "value": "Wirelessly connect up to 2 smartphones or tablets to the speaker and take turns enjoying JBL Pro sound.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "b75217d2-8cca-464e-b98a-fb5f932e270e",
        "title": "Crank Up The Fun With PartyBoost",
        "value": "JBL PartyBoost allows you to pair compatible speakers (Flip 6, Charge 5, Pulse 4, Extreme 3, Boombox 3) to truly pump up your party.",
        "information": "Product Feature"
      },
      {
        "_type": "overviewField",
        "_key": "595b84ff-bb87-45c5-858b-25ad8250ae7e",
        "title": "Power Up With The Built-In Powerbank",
        "value": "Don’t put the party on pause. A built-in power bank lets you charge your devices without taking a break from the tunes.",
