  ```
  export interface CatalogueTreeNode {
    _key: string;
    _type: "catalogueItem";
    title: string;
    type: "link" | "header";
    slug?: { _type: "slug"; current: string };
    icon?: string;
    children?: CatalogueTreeNode[];
  }
  export type CatalogueTree = CatalogueTreeNode[];
  ```
