{
  "name": "sang-logium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev-no-turbo": "next dev",
    "webhook": "stripe listen --forward-to localhost:3000/api/webhook",
    "dev:stripe": "concurrently \"npm run dev\" \"npm run webhook\"",
    "prebuild": "node scripts/build-catalogue-index.mjs",
    "build": "npm run prebuild && next build",
    "start": "next start",
    "prod": "npm run build && npm run start",
    "lint": "eslint .",
    "lint-strict": "eslint . --max-warnings 0",
    "test:ci": "vitest run --coverage",
    "typegen": "sanity schema extract && sanity typegen generate",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:homepage:unit": "vitest run tests/unit/homepage/",
    "test:homepage:component": "npx playwright test --config=playwright-ct.config.ts",
    "test:e2e": "npx playwright test",
    "test:performance": "npx playwright test --config=playwright.performance.config.ts",
    "test:e2e:dev": "npx playwright test --project=desktop-chromium",
    "test:checkout": "npx playwright test tests/checkout/guest-checkout-inventory-reservation/ --project=desktop-chromium",
    "test:checkout:all": "npx playwright test tests/checkout/guest-checkout-inventory-reservation/",
    "test:checkout:quick": "npx playwright test tests/checkout/quick-test.test.ts --config=playwright.checkout.config.ts",
    "test:checkout:fast": "npx playwright test --config=playwright.checkout.config.ts",
    "test:e2e:android": "npx playwright test --project=android-pixel",
    "test:e2e:iphone": "npx playwright test --project=iphone-legacy",
    "test:e2e:api": "npx playwright test --project=api",
    "test:golden": "npx playwright test tests/e2e/checkout/guest/golden-path.spec.ts tests/e2e/checkout/auth/golden-path.spec.ts",
    "test:report": "npx playwright show-report",
    "test:homepage:regression": "npx playwright test tests/e2e/homepage/regression.spec.ts",
    "test:homepage:a11y": "npx playwright test tests/e2e/homepage/accessibility.spec.ts",
    "test:homepage:rwd": "npx playwright test tests/e2e/homepage/rwd-matrix.spec.ts",
    "test:homepage:sections": "npx playwright test tests/e2e/homepage/sections.spec.ts",
    "ts-check": "tsc --noEmit --pretty",
    "ts-check:watch": "tsc --noEmit --watch",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.6.11",
    "@googlemaps/addressvalidation": "^3.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "0.17.3",
    "@next/bundle-analyzer": "^16.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@sanity/icons": "^3.4.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/types": "^3.74.1",
    "@sanity/vision": "^3.99.0",
    "@sentry/nextjs": "^10.65.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/redis": "^1.37.0",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.14",
    "better-auth": "1.6.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "critters": "^0.0.25",
    "dotenv": "^16.4.5",
    "groq-builder": "^0.10.0",
    "iron-session": "^8.0.4",
    "isomorphic-dompurify": "^2.36.0",
    "jose": "^6.1.2",
    "kysely-libsql": "0.7.1",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.9",
    "next": "^15.5.9",
    "next-safe-action": "^8.5.3",
    "next-sanity": "^9.12.3",
    "next-sanity-image": "^6.2.0",
    "nuqs": "^2.8.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.24",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.66.0",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^9.14.1",
    "react-is": "^19.2.0",
    "react-payment-icons": "^1.2.6",
    "resend": "^6.12.4",
    "sanity": "^3.74.1",
    "sharp": "^0.33.5",
    "stripe": "^22.2.0",
    "styled-components": "^6.3.12",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "undici": "^8.1.0",
    "use-debounce": "^10.0.4",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2",
    "web-vitals": "^5.2.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/experimental-ct-react": "^1.59.1",
    "@playwright/test": "^1.59.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__template": "^7.4.4",
    "@types/hast": "^3.0.4",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/trusted-types": "^2.0.7",
    "@types/unist": "^3.0.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "local-ssl-proxy": "^2.0.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "type-coverage": "^2.29.7",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.5"
  }
}
