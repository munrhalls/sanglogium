{
  "name": "sang-logium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-no-turbo": "next dev",
    "dev:test": "next dev --turbopack -p 3001",
    "webhook": "stripe listen --forward-to localhost:3000/api/webhook",
    "dev:stripe": "concurrently \"npm run dev\" \"npm run webhook\"",
    "prebuild": "node scripts/build-catalogue-index.mjs",
    "build": "npm run prebuild && next build",
    "deploy": "netlify deploy --prod",
    "verify": "node verify-deployment.js",
    "start": "next start",
    "prod": "npm run build && npm run start",
    "lint": "eslint .",
    "lint-strict": "eslint . --max-warnings 0",
    "test:ci": "vitest run --coverage",
    "backup": "node backup-env.js",
    "predeploy": "node verify-env.js",
    "seed": "ts-node --esm seedCategories.ts",
    "typegen": "sanity schema extract && sanity typegen generate",
    "test": "vitest",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:homepage:unit": "vitest run tests/unit/homepage/",
    "test:homepage:component": "npx playwright test-ct tests/component/",
    "test:homepage:e2e": "npx playwright test tests/e2e/homepage/",
    "test:homepage:regression": "npx playwright test tests/e2e/homepage/regression.spec.ts",
    "test:homepage:a11y": "npx playwright test tests/e2e/homepage/accessibility.spec.ts",
    "test:homepage:rwd": "npx playwright test tests/e2e/homepage/rwd-matrix.spec.ts",
    "test:homepage:sections": "npx playwright test tests/e2e/homepage/sections.spec.ts",
    "test:homepage:all": "npm run test:homepage:unit && npm run test:homepage:component && npm run test:homepage:e2e",
    "ts-check": "tsc --noEmit --pretty",
    "ts-check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.16.0",
    "@googlemaps/addressvalidation": "^3.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.56.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@sanity/icons": "^3.4.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/types": "^3.74.1",
    "@sanity/vision": "^3.99.0",
    "@sentry/react": "^8.52.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "@types/webpack": "^5.28.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "groq-builder": "^0.10.0",
    "jose": "^6.1.2",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.9",
    "next": "^15.5.9",
    "next-safe-action": "^8.0.11",
    "next-sanity": "^9.12.3",
    "next-sanity-image": "^6.2.0",
    "nuqs": "^2.8.3",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.66.0",
    "react-intersection-observer": "^9.14.1",
    "react-is": "^19.2.0",
    "sang-logium": "file:",
    "sanity": "^3.74.1",
    "sharp": "^0.33.5",
    "stripe": "^19.1.0",
    "styled-components": "^6.3.12",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "use-debounce": "^10.0.4",
    "vaul": "^1.1.2",
    "zod": "^4.1.12",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.5",
    "@netlify/plugin-nextjs": "^5.15.1",
    "@next/bundle-analyzer": "^16.1.3",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__template": "^7.4.4",
    "@types/hast": "^3.0.4",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18",
    "@types/trusted-types": "^2.0.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "critters": "^0.0.25",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "local-ssl-proxy": "^2.0.5",
    "postcss": "^8.4.24",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-multi-carousel": "^2.8.5",
    "tailwindcss": "^3.3.5",
    "type-coverage": "^2.29.7",
    "typescript": "^5",
    "typescript-eslint": "^8.57.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.13"
  }
}
