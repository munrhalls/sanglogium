    "@types/babel__template": "^7.4.4",
    "@types/hast": "^3.0.4",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/trusted-types": "^2.0.7",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
