    "@sanity/image-url": "^1.2.0",
    "@sanity/types": "^3.74.1",
    "@sanity/vision": "^3.99.0",
    "@sentry/nextjs": "^10.65.0",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.14",
    "better-auth": "1.6.11",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "iron-session": "^8.0.4",
    "isomorphic-dompurify": "^2.36.0",
    "jose": "^6.1.2",
    "kysely-libsql": "0.7.1",
    "nanoid": "^5.0.9",
    "next": "^15.5.9",
    "next-sanity": "^9.12.3",
    "nuqs": "^2.8.3",
    "postcss": "^8.4.24",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.0",
    "resend": "^6.12.4",
    "sanity": "^3.74.1",
    "sharp": "^0.33.5",
    "stripe": "^22.2.0",
    "styled-components": "^6.3.12",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "uuid": "^13.0.0",
