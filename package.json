{
  "name": "sang-logium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-no-turbo": "next dev",
    "prebuild": "node scripts/build-catalogue-index.mjs",
    "build": "npm run prebuild && next build",
    "start": "next start",
    "prod": "npm run build && npm run start",
    "laws": "node --experimental-strip-types --import ./tools/laws-loader.mjs --test \"features/**/*.laws.ts\"",
    "lint": "eslint .",
    "lint-strict": "eslint . --max-warnings 0",
    "typegen": "sanity schema extract && sanity typegen generate",
    "ts-check": "tsc --noEmit --pretty",
    "ts-check:watch": "tsc --noEmit --watch",
    "analyze": "ANALYZE=true npm run build",
    "commit": "bash tools/commit.sh"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.6.11",
    "@next/bundle-analyzer": "^16.1.3",
    "@phosphor-icons/react": "^2.1.10",
