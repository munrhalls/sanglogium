### [P3-2] SCOPE CONTRACT: AI Agent Consume Pattern
**Complexity:** 4 (Windsurf integration)
**Estimated Time:** 3 hours
**Deliverable:** D4 - Windsurf/Cascade auto-loads research context

#### IN SCOPE
- Function: `agents/research/consume_agent.py` with `prime_context()`
- Windsurf workflow: `.windsurf/workflows/research-consume.md`
- Auto-load research into Cascade context (file-based injection)
- Category filtering for agent

#### OUT OF SCOPE
- MCP server integration (Phase 4 enhancement)
- Real-time WebSocket updates
- Context persistence across sessions

#### STEP-BY-STEP IMPLEMENTATION

```python
# agents/research/consume_agent.py
"""
AI Agent consume pattern for research queue.
Provides research context for Windsurf/Cascade integration.
"""

import json
from typing import Optional, List
from agents.research.queue import get_items_for_agent, mark_consumed, ResearchItem

def get_research_context(
    category: Optional[str] = None,
    max_items: int = 3,
    auto_consume: bool = False
) -> str:
    """
    Get research findings formatted for AI agent consumption.
    
    Args:
        category: Filter by category (tech-watch, competitor, etc.)
        max_items: Maximum items to include
        auto_consume: If True, mark items as consumed after retrieval
    
    Returns:
        Formatted string for priming AI agent context
    """
    items = get_items_for_agent(category=category, limit=max_items)
    
    if not items:
        return "# Research Context\n\nNo pending research items in queue."
    
    sections = ["# Research Context", ""]
    sections.append(f"**{len(items)} research items available for context priming:**")
    sections.append("")
    
    for i, item in enumerate(items, 1):
        findings = item.findings
        
        sections.append(f"## Research Item {i}: {item.query}")
        sections.append(f"- **Priority:** {item.priority}")
        sections.append(f"- **Category:** {item.category}")
        sections.append("")
        sections.append("### Executive Summary")
        sections.append(findings.get("executive_summary", "N/A"))
        sections.append("")
        
        sections.append("### Key Findings")
        for finding in findings.get("key_findings", [])[:3]:  # Limit to 3
            sections.append(f"- {finding}")
        sections.append("")
        
        sections.append("### Recommended Actions")
        for action in findings.get("recommended_actions", [])[:2]:  # Limit to 2
            sections.append(f"- {action}")
        sections.append("")
    
    # Auto-consume if requested
    if auto_consume:
        for item in items:
            mark_consumed(item.id, "windsurf-agent")
        sections.append("*(Items marked as consumed)*")
    else:
        sections.append("*(Items remain in queue for human review)*")
    
    return "\n".join(sections)

def get_research_summary() -> dict:
    """Get quick summary for agent decision-making."""
    items = get_items_for_agent(limit=10)
    
    return {
        "available_items": len(items),
        "by_category": _group_by_category(items),
        "by_priority": _group_by_priority(items),
        "recommendation": _generate_recommendation(items)
    }

def _group_by_category(items: List[ResearchItem]) -> dict:
    """Group items by category."""
    groups = {}
    for item in items:
        cat = item.category
        groups.setdefault(cat, 0)
        groups[cat] += 1
    return groups

def _group_by_priority(items: List[ResearchItem]) -> dict:
    """Group items by priority."""
    groups = {"critical": 0, "high": 0, "normal": 0, "low": 0}
    for item in items:
        if item.priority in groups:
            groups[item.priority] += 1
    return groups

def _generate_recommendation(items: List[ResearchItem]) -> str:
    """Generate recommendation based on queue state."""
    if not items:
        return "No research pending. Proceed with standard workflow."
    
    critical = sum(1 for i in items if i.priority == "critical")
    if critical > 0:
        return f"⚠️ {critical} critical research items pending. Review before proceeding."
    
    high = sum(1 for i in items if i.priority == "high")
    if high > 0:
        return f"📋 {high} high-priority research items available for context."
    
    return f"📚 {len(items)} research items available. Consider loading context if relevant."
```

```markdown
