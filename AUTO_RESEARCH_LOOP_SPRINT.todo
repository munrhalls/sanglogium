#### STEP-BY-STEP IMPLEMENTATION

```python
# agents/research/consume_human.py
"""
Human consume pattern for research queue.
Interactive CLI for morning review routine.
"""

import json
from datetime import datetime
from pathlib import Path
from agents.research.queue import consume_next_item, get_queue_stats, ResearchItem

DIGEST_DIR = Path("c:/webdev/sang-logium/_research/digest")
DIGEST_DIR.mkdir(exist_ok=True)

def display_item(item: ResearchItem) -> None:
    """Display research item in readable format."""
    print("\n" + "="*60)
    print(f"PRIORITY: {item.priority.upper()}")
    print(f"CATEGORY: {item.category}")
    print(f"QUERY: {item.query}")
    print("-"*60)
    
    findings = item.findings
    print(f"\nEXECUTIVE SUMMARY:\n{findings.get('executive_summary', 'N/A')}")
    
    print("\nKEY FINDINGS:")
    for i, finding in enumerate(findings.get('key_findings', []), 1):
        print(f"  {i}. {finding}")
    
    print("\nRECOMMENDED ACTIONS:")
    for action in findings.get('recommended_actions', []):
        print(f"  → {action}")
    
    print("\nSOURCES:")
    for source in findings.get('sources', [])[:3]:  # Limit to 3
        print(f"  • {source}")
    
    print("="*60)

def prompt_action() -> str:
    """Prompt user for action."""
    print("\nACTIONS:")
    print("  [a]ction - Create task from this research")
    print("  [s]kip   - Archive without action")
    print("  [q]uit   - Stop reviewing")
    
    while True:
        choice = input("\nChoice [a/s/q]: ").strip().lower()
        if choice in ['a', 's', 'q', 'action', 'skip', 'quit']:
            return choice[0]
        print("Invalid choice. Please enter a, s, or q.")

def generate_digest() -> Path:
    """Generate markdown digest of consumed research."""
    today = datetime.now().strftime("%Y-%m-%d")
    digest_path = DIGEST_DIR / f"{today}.md"
    
    archive_dir = Path("c:/webdev/sang-logium/_research/archive")
    today_items = []
    
    for filepath in archive_dir.glob("*.json"):
        data = json.loads(filepath.read_text())
        consumed_at = data.get("consumed_at", "")
        if consumed_at.startswith(today) and data.get("consumed_by") == "human":
            today_items.append(data)
    
    # Sort by priority
    priority_order = {"critical": 0, "high": 1, "normal": 2, "low": 3}
    today_items.sort(key=lambda x: priority_order.get(x.get("priority"), 4))
    
    # Generate markdown
    lines = [
        f"# Research Digest - {today}",
        "",
        f"**Items Reviewed:** {len(today_items)}",
        "",
        "## Summary by Category",
        ""
    ]
    
    categories = {}
    for item in today_items:
        cat = item.get("category", "general")
        categories.setdefault(cat, []).append(item)
    
    for cat, items in sorted(categories.items()):
        lines.append(f"- **{cat}:** {len(items)} items")
    
    lines.extend(["", "## Key Findings", ""])
    
    for item in today_items:
        findings = item.get("findings", {})
        lines.append(f"### [{item.get('priority', 'normal').upper()}] {item.get('query', 'Unknown')}")
        lines.append("")
        lines.append(findings.get("executive_summary", "No summary available."))
        lines.append("")
    
    digest_path.write_text("\n".join(lines))
    print(f"\n[DIGEST] Generated: {digest_path}")
    
    return digest_path

def main():
    """Main review loop."""
    print("="*60)
    print("RESEARCH INBOX REVIEW")
    print("="*60)
    
    # Show stats
    stats = get_queue_stats()
    print(f"\nQueue Status: {stats['total_unconsumed']} items pending")
    for prefix, counts in stats["inbox"].items():
        if counts["unconsumed"] > 0:
            print(f"  {prefix}: {counts['unconsumed']} items")
    
    if stats["total_unconsumed"] == 0:
        print("\n✓ Inbox empty! Nothing to review.")
        return
    
    print("\nStarting review...\n")
    
    reviewed = 0
    while True:
        item = consume_next_item("human")
        if item is None:
            break
        
        display_item(item)
        action = prompt_action()
        
        if action == 'a':
            # TODO: Integration with task system
            print("  → Marked for action (integrate with your task system)")
            reviewed += 1
        elif action == 's':
            print("  → Skipped/archived")
            reviewed += 1
        elif action == 'q':
            print("  → Quitting review")
            break
    
    print(f"\n{'='*60}")
    print(f"Review complete: {reviewed} items processed")
    
    # Generate digest
    if reviewed > 0:
        digest = generate_digest()
        print(f"Digest saved: {digest}")

if __name__ == "__main__":
    main()
```

