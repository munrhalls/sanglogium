"""Verify Ollama + smolagents integration."""

from smolagents import CodeAgent, WebSearchTool, LiteLLMModel

def test_basic_agent():
    """Test: Can we run a local LLM with web search?"""
    print("Testing Ollama + smolagents integration...")
    
    # Use local Gemma 3 via Ollama
    model = LiteLLMModel(model_id="ollama_chat/gemma3:4b")
    
    # Create agent with web search
    agent = CodeAgent(
        tools=[WebSearchTool()],
        model=model,
        max_steps=3
    )
    
    # Test query
    result = agent.run(
        "What are the top 3 new features in Next.js 15? "
        "Return as bullet points."
    )
    
    print("\n=== RESULT ===")
    print(result)
    print("\n=== TEST PASSED ===")
    return True

if __name__ == "__main__":
    test_basic_agent()
```

