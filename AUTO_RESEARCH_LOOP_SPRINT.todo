## PHASE 2: RESEARCH QUEUE (Days 4-6)

### [P2-1] SCOPE CONTRACT: Build File-Based Research Queue
**Complexity:** 5 (requires robust file handling)
**Estimated Time:** 4 hours
**Deliverable:** D2 - Producer module, JSON queue, idempotent operations

#### IN SCOPE
- Module: `agents/research/queue.py` with producer/consumer functions
- Directory structure: `_research/inbox/`, `_research/archive/`
- JSON format for research items
- Idempotent operations (safe to re-run)
- Priority levels: critical, high, normal, low

#### OUT OF SCOPE
- Database backend (SQLite/PostgreSQL)
- Web interface for queue management
- Real-time notifications

#### ARCHITECTURE DECISIONS
- **Storage:** JSON files on filesystem (simple, inspectable, git-trackable)
- **Naming:** `{timestamp}_{category}_{hash}.json` (sortable, unique)
- **Priority:** File prefix `[P0]`, `[P1]`, etc. for visual sorting
- **Idempotency:** Content hash prevents duplicates

#### STEP-BY-STEP IMPLEMENTATION

```python
# agents/research/queue.py
"""
File-based research queue.
Producer: queue_research()
Consumer: consume_next_item() [human] or get_items_for_agent() [AI]
"""

import json
import hashlib
from datetime import datetime
from pathlib import Path
from typing import Optional, Literal
from dataclasses import dataclass, asdict

# Paths
RESEARCH_DIR = Path("c:/webdev/sang-logium/_research")
INBOX_DIR = RESEARCH_DIR / "inbox"
ARCHIVE_DIR = RESEARCH_DIR / "archive"

# Ensure directories exist
INBOX_DIR.mkdir(parents=True, exist_ok=True)
ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)

Priority = Literal["critical", "high", "normal", "low"]

@dataclass
class ResearchItem:
    id: str
    timestamp: str
    query: str
    category: str
    priority: Priority
    findings: dict
    consumed: bool
    consumed_by: Optional[str]
    consumed_at: Optional[str]
    content_hash: str

def _generate_id(query: str, timestamp: str) -> str:
    """Generate unique ID from content hash."""
    content = f"{query}{timestamp}"
    return hashlib.md5(content.encode()).hexdigest()[:12]

def _priority_prefix(priority: Priority) -> str:
    """Map priority to file prefix for sorting."""
    return {"critical": "[P0]", "high": "[P1]", "normal": "[P2]", "low": "[P3]"}[priority]

def queue_research(
    query: str,
    category: str = "general",
    priority: Priority = "normal",
    findings: Optional[dict] = None
) -> str:
    """
    Producer: Add research item to queue.
    
    Args:
        query: The research query/question
        category: Category for organization (tech-watch, competitor, etc.)
        priority: critical | high | normal | low
        findings: Optional pre-computed findings (otherwise agent runs)
    
    Returns:
        item_id: Unique ID for this research item
    """
    timestamp = datetime.now().isoformat()
    item_id = _generate_id(query, timestamp)
    
    # Generate findings if not provided
    if findings is None:
        findings = _run_research_agent(query)
    
    item = ResearchItem(
        id=item_id,
        timestamp=timestamp,
        query=query,
        category=category,
        priority=priority,
        findings=findings,
        consumed=False,
        consumed_by=None,
        consumed_at=None,
        content_hash=hashlib.md5(str(findings).encode()).hexdigest()[:8]
    )
    
    # Save to inbox
    prefix = _priority_prefix(priority)
    filename = f"{prefix}_{timestamp[:10]}_{category}_{item_id}.json"
    filepath = INBOX_DIR / filename
    
    filepath.write_text(json.dumps(asdict(item), indent=2))
    print(f"[QUEUE] Research queued: {filepath.name}")
    
    return item_id

def _run_research_agent(query: str) -> dict:
    """Run smolagents research and return structured findings."""
    from smolagents import CodeAgent, WebSearchTool, LiteLLMModel
    
    model = LiteLLMModel(model_id="ollama_chat/gemma3:4b")
    agent = CodeAgent(
        tools=[WebSearchTool()],
        model=model,
        max_steps=4
    )
    
    structured_prompt = f"""
Research: {query}

Return findings as JSON with this structure:
{{
    "executive_summary": "2-3 sentence overview",
    "key_findings": ["finding 1", "finding 2", "finding 3"],
    "sources": ["url1", "url2"],
    "recommended_actions": ["action 1", "action 2"],
    "confidence": "high|medium|low"
}}
"""
    
    result = agent.run(structured_prompt)
    
    # Try to parse as JSON, fallback to wrapping raw text
    try:
        if isinstance(result, str):
            # Extract JSON from markdown code blocks if present
            if "```json" in result:
                json_str = result.split("```json")[1].split("```")[0].strip()
            elif "```" in result:
                json_str = result.split("```")[1].split("```")[0].strip()
            else:
                json_str = result
            return json.loads(json_str)
        return result
    except json.JSONDecodeError:
        return {
            "executive_summary": str(result)[:200],
            "key_findings": [str(result)],
            "sources": [],
            "recommended_actions": ["Review raw findings"],
            "confidence": "unknown",
            "raw_output": str(result)
        }

def consume_next_item(consumer_id: str = "human") -> Optional[ResearchItem]:
    """
    Consumer (Human): Get next unconsumed item, mark consumed, archive.
    
    Priority order: critical > high > normal > low
    Within priority: oldest first (FIFO)
    """
    priority_order = ["[P0]", "[P1]", "[P2]", "[P3]"]
    
    for prefix in priority_order:
        # Find files with this priority prefix
        files = sorted(INBOX_DIR.glob(f"{prefix}_*.json"))
        
        for filepath in files:
            data = json.loads(filepath.read_text())
            
            if not data.get("consumed", False):
                # Mark consumed
                data["consumed"] = True
                data["consumed_by"] = consumer_id
                data["consumed_at"] = datetime.now().isoformat()
                
                # Save updated state
                filepath.write_text(json.dumps(data, indent=2))
                
                # Move to archive
                archive_path = ARCHIVE_DIR / filepath.name
                filepath.rename(archive_path)
                
                print(f"[CONSUME] {filepath.name} → archived")
                return ResearchItem(**data)
    
    return None

def get_items_for_agent(
    category: Optional[str] = None,
    limit: int = 5
) -> list[ResearchItem]:
    """
    Consumer (AI Agent): Get unconsumed items without marking consumed.
    Agent decides what to use, marks consumed separately.
    """
    items = []
    files = sorted(INBOX_DIR.glob("*.json"))
    
    for filepath in files:
        data = json.loads(filepath.read_text())
        
        if not data.get("consumed", False):
            if category is None or data.get("category") == category:
                items.append(ResearchItem(**data))
                if len(items) >= limit:
                    break
    
    return items

def mark_consumed(item_id: str, consumer_id: str = "agent") -> bool:
    """Mark specific item as consumed and archive it."""
    for filepath in INBOX_DIR.glob(f"*_{item_id}.json"):
        data = json.loads(filepath.read_text())
        data["consumed"] = True
        data["consumed_by"] = consumer_id
        data["consumed_at"] = datetime.now().isoformat()
        
        filepath.write_text(json.dumps(data, indent=2))
        
        archive_path = ARCHIVE_DIR / filepath.name
        filepath.rename(archive_path)
        
        print(f"[MARKED] {item_id} consumed by {consumer_id}")
        return True
    
    return False

def get_queue_stats() -> dict:
    """Get statistics about current queue state."""
    stats = {"inbox": {}, "total_unconsumed": 0}
    
    for prefix in ["[P0]", "[P1]", "[P2]", "[P3]"]:
        files = list(INBOX_DIR.glob(f"{prefix}_*.json"))
        unconsumed = sum(
            1 for f in files 
            if not json.loads(f.read_text()).get("consumed", False)
        )
        stats["inbox"][prefix] = {"total": len(files), "unconsumed": unconsumed}
        stats["total_unconsumed"] += unconsumed
    
    return stats
```

#### DEFINITIONS OF DONE

- [ ] **DoD 1.1:** `agents/research/queue.py` exists with all functions
- [ ] **DoD 1.2:** `_research/inbox/` and `_research/archive/` directories created
- [ ] **DoD 1.3:** `queue_research()` creates JSON files with correct structure
- [ ] **DoD 1.4:** `consume_next_item()` returns items in priority order
- [ ] **DoD 1.5:** `get_items_for_agent()` returns items without consuming
- [ ] **DoD 1.6:** `mark_consumed()` moves files to archive
- [ ] **DoD 1.7:** `get_queue_stats()` returns accurate counts

