{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "store/**/*.ts",
    "store/**/*.tsx",
    "sanity/**/*.ts",
    "middleware.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "sanity.config.ts",
    "sanity.cli.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    ".turbo",
    ".cache",
    "coverage",
    ".nyc_output",
    "test-results",
    "playwright-report",
    "playwright-report/**/*",
    "tests",
    "tests/**/*",
    "scripts",
    "scripts/**/*",
    "public",
    "public/**/*",
    "docs",
    "docs/**/*",
    ".sanity",
    ".sanity/**/*",
    "dist",
    "dist/**/*",
    "build",
    "build/**/*",
    "data",
    "data/**/*",
    "venv",
    "venv/**/*",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.js",
    "**/*.spec.jsx"
  ]
}